<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>slugbot_package</name>
  <version>0.0.0</version>
  <description>An example Webots package</description>
  <maintainer email="arthongreenspan@gmail.com">arthon</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <exec_depend>rclpy</exec_depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>messages</depend>
  <depend>webots_ros2_driver</depend>
  <depend>pluginlib</depend>
  <depend>sensor_msgs</depend>
  <build_depend>ament_index_cpp</build_depend>
  <exec_depend>ament_index_cpp</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
